#!/usr/bin/env bash
# tq — THE task queue. The companion deliberately does NOT use Claude Code's native task
# tools (they're gated off on the newest models and we want the queue self-owned and stable);
# `tq` is the whole queue, writing a JSON-per-task store the companion owns. The model drives
# it: `tq add/doing/note/done-when/done/cancel/list/report`. Best-effort + never destructive
# (nothing is deleted — `cancel` sets a status; the file stays for audit); self-contained.
# **Concurrent-safe id allocation (was single-writer):** `claim_id` reserves an id with O_EXCL
# because a HOOK now writes here too (R84). The older note below is kept for context — its premise
# no longer holds, which is exactly why the allocation changed. Historic note: id allocation was
# not locked — concurrent `add`s could in principle collide on an id, but that isn't a real
# usage pattern; don't add locking for it.
# Store: CLAUDE_COMPANION_TASKS_DIR (its OWN dir, not ~/.claude/tasks). Each session dir is
# stamped with its repo root (`.root`) so resume can scope to a repo without reading any
# native session transcript.
set -uo pipefail
command -v jq >/dev/null 2>&1 || { echo "tq: jq required" >&2; exit 1; }

SID="${CLAUDE_COMPANION_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-}}"
[ -n "$SID" ] || { echo "tq: no session id (CLAUDE_CODE_SESSION_ID unset)" >&2; exit 1; }
# THE QUEUE IS REPO STATE (R96 stage 2) — mirrors lib/companion.sh companion_session_dir, which tq
# cannot source because it is deliberately standalone. An explicit CLAUDE_COMPANION_TASKS_DIR wins
# absolutely; otherwise the store lives in the repo so a fresh container inherits the queue instead
# of starting empty. A session already in the legacy home store keeps working there, so upgrading
# never orphans an in-flight queue.
# The repo store is FLAT: one id space per repo, no session subdirectory. Session partitioning is
# why a clone could carry tasks its own drain could not see — this reads one directory, and a fresh
# container always has a new session id. An explicit CLAUDE_COMPANION_TASKS_DIR is a GLOBAL store by
# definition and keeps its partitioning. Mirrors lib/companion.sh companion_session_dir, which tq
# cannot source because it is deliberately standalone.
_qroot="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
_qlegacy="$HOME/.claude/companion/tasks/$SID"
if [ -n "${CLAUDE_COMPANION_TASKS_DIR:-}" ]; then
  STORE="$CLAUDE_COMPANION_TASKS_DIR"; DIR="$STORE/$SID"
elif [ -d "$_qlegacy" ]; then
  # A session already living in the legacy store never migrates mid-flight, or its queue would
  # SPLIT across two stores. New sessions use the repo store.
  STORE="$HOME/.claude/companion/tasks"; DIR="$_qlegacy"
elif [ -n "$_qroot" ]; then
  STORE="$_qroot/.companion/tasks"; DIR="$STORE"
else
  STORE="$HOME/.claude/companion/tasks"; DIR="$_qlegacy"
fi

# usage() + report() live in tq-output.sh (rendering, not mechanics). SOURCED so they share this
# shell's $DIR/$STORE and stdout. Resolved from $0's dir like the other siblings; if it is missing
# tq must still RUN — a queue that dies because its help text moved is worse than one with no help.
_out="$(dirname "$0")/tq-output.sh"
# shellcheck source=./tq-output.sh
[ -r "$_out" ] && . "$_out"


next_id() { local f n max=0; for f in "$DIR"/*.json; do [ -f "$f" ] || continue
  n="$(basename "$f" .json)"; case "$n" in ''|*[!0-9]*) continue;; esac; [ "$n" -gt "$max" ] && max="$n"; done; printf '%d' $((max+1)); }
# CLAIM an id atomically, then fill it. `next_id`+write raced: two writers computed the same id and
# the second `mv` silently overwrote the first — one task simply vanished. That was acceptable while
# "one model drives tq serially" held, but the ask-guard now writes from a HOOK (R84), so the store
# has genuinely concurrent writers and the old premise is void. `set -o noclobber` gives O_EXCL:
# exactly one racer can create a given path, everyone else retries at the next free id.
# The reserved file is briefly EMPTY; `jq -s` ignores an empty input (verified), so a crash in that
# window costs a gap in the numbering, never a corrupted or lost task.
claim_id() { local id try=0
  while :; do
    id="$(next_id)"
    if ( set -o noclobber; : > "$DIR/$id.json" ) 2>/dev/null; then printf '%s' "$id"; return 0; fi
    try=$((try+1)); [ "$try" -lt 100 ] || { printf '%s' "$id"; return 1; }
  done; }
# Every write goes to a temp file then `mv` over the target — atomic-rename is deliberate crash-safety
# (R44), NOT idiom: a task file is never left half-written if jq errors or the process dies mid-write,
# which is what protects crash-resume (breadcrumbs + done-when surviving a crash). jq can't edit in
# place, so temp+rename is the crash-safe form. Do NOT "simplify" to `jq … > "$f"`. (Same for `add`.)
set_task() { local f="$DIR/$1.json" t="$DIR/.$1.tmp"; jq --arg s "$2" --arg d "$3" \
  '(if $s!="" then .status=$s else . end)|(if $d!="" then .description=$d else . end)' "$f" >"$t" && mv "$t" "$f"; }
# `note` APPENDS to .notes[] (ts+text) instead of overwriting .description, so a second breadcrumb
# on the same task doesn't erase the first — the crash-resume trail is cumulative (same temp+rename
# crash-safety as set_task, R44). Ported from PR #126 (author @andrewstanbury-thinkific).
append_note() { local f="$DIR/$1.json" t="$DIR/.$1.tmp" ts
  ts="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf '0Z')"
  jq --arg ts "$ts" --arg x "$2" '.notes=((.notes//[])+[{ts:$ts,text:$x}])' "$f" >"$t" && mv "$t" "$f"; }

# --- repo identity (R63) ---
# The queue lives in the repo now, so nothing needs carrying between machines — git does it. The
# export/import pair that used to live here was DELETED 2026-08-05 (R60 reversed): it duplicated
# what git already carries, and could carry something git never would — a stale copy. It did:
# `/companion:resume` auto-imported a three-day-old export and resurrected 13 completed tasks.
repo_root() { git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD"; }
# Repo IDENTITY — a per-working-tree id (a random tag in the tree's own git dir) that survives a
# MOVE but stays distinct across worktrees/clones/forks. Stamped as `.repo`; matching prefers it so
# a moved repo keeps its queue while a worktree/clone gets its own. NOT the root-commit SHA (that
# identifies history → worktrees/clones would collide, R63). Mirrors lib/companion.sh companion_repo_id.
repo_id() { local f id
  f="$(git -C "$PWD" rev-parse --git-path companion-repo-id 2>/dev/null)" || true
  if [ -z "$f" ]; then repo_root; return; fi
  case "$f" in /*) : ;; *) f="$PWD/$f" ;; esac
  if [ -f "$f" ]; then cat "$f"; return; fi
  id="$(head -c16 /dev/urandom 2>/dev/null | od -An -tx1 2>/dev/null | tr -d ' \n\r')"
  if [ -z "$id" ]; then id="p$$"; fi
  printf '%s' "$id" > "$f" 2>/dev/null || true
  printf '%s' "$id"; }
# Every *.json across sessions whose `.root` stamp equals $1 — the repo-scoped task set (same
# scoping rule as lib/companion.sh `companion_open_tasks`, so export/resume agree on membership).

# Delta line (R69): mutations print ONE line — glyph counts + → next — not the full queue. The
# model just wrote the op; reading the whole queue back on every add/doing was linear-in-queue-size
# token spend for no new information. The full report still fires at the boundaries that anchor:
# `done` (a completion re-orients), `import`, explicit `report`, and session-start/compact (lib).
delta() {
  local files=("$DIR"/*.json); [ -e "${files[0]}" ] || { printf '📋 (empty)\n'; return 0; }
  jq -rs '
    def pk: ((.subject//"")|sub("^\\s+";"")|startswith("❓")); def bl: ((.subject//"")|sub("^\\s+";"")|startswith("⏳"));
    # ⛔ = a hypothesis the OWNER closed. It is not work and must never be offered, but it has to
    # survive compaction — the Apple/AWS incident happened because "confirmed twice" lived only in
    # a context window. A prefix-view over pending, exactly like ❓/⏳ (R42), so it rides the same
    # resume path that already re-injects open tasks.
    def rl: ((.subject//"")|sub("^\\s+";"")|startswith("⛔"));
    (map(select(.status=="in_progress"))|sort_by(.id|tonumber)) as $ip
    |(map(select(.status=="pending" and (pk|not) and (bl|not) and (rl|not)))|sort_by(.id|tonumber)) as $op
    |([ (if($ip|length)>0 then "▸\($ip|length)" else empty end),
        (if($op|length)>0 then "◻\($op|length)" else empty end),
        ((map(select(.status=="pending" and pk))|length) as $n | if $n>0 then "❓\($n)" else empty end),
        ((map(select(.status=="pending" and bl))|length) as $n | if $n>0 then "⏳\($n)" else empty end),
        ((map(select(.status=="pending" and rl))|length) as $n | if $n>0 then "⛔\($n)" else empty end),
        ((map(select(.status=="completed"))|length) as $n | if $n>0 then "✔\($n)" else empty end)]|join(" ")) as $h
    |(($ip[0] // $op[0]) as $nx
      | "📋 " + (if $h=="" then "(all clear)" else $h end)
        + (if $nx then "  → next: #\($nx.id)" else "" end))
  ' "${files[@]}" 2>/dev/null || printf '📋 (unreadable)\n'
}

# stopfields <sweep-bool> — the Stop hook's view of the queue, as ONE machine-readable record.
# R86·b (owner-decided 2026-08-02): "first startable task" was implemented HERE and again in
# stop-autopilot.sh. The two diverged, and the hook offered a task blocked on an unanswered park
# four turns running. The owner's rule is that drift should not be something we manage, so the
# selection lives in exactly one place and the hook reads it.
#
# US (0x1f) separated, seven fields: open · plain · done · next-subject · next-id · done-when ·
# startable-count. NOT tab: tab is IFS whitespace, so an empty done_when would collapse two
# delimiters and shift every later field left (LESSONS).
# NOTE: no apostrophes anywhere in this jq program — a single quote ENDS it (LESSONS).
stopfields() {
  local files=("$DIR"/*.json); [ -e "${files[0]}" ] || return 1
  jq -rs --argjson sw "${1:-false}" '
    def subj: ((.subject//"")|sub("^\\s+";""));
    def waits: [(subj | match("after #([0-9]+)";"g").captures[0].string)];
    def parked: (subj|startswith("❓"));
    # Sweep eligibility is a POSITIVE MARKER the parker wrote, never an inference over prose:
    # `rev:` means reversible-but-yours, and an anchored `rec:` means a pick was recorded.
    def sweepable: parked
      and ((subj|ascii_downcase|contains("decompose:"))|not)
      and (subj|test("^❓\\s*\\[parked\\]\\s*rev:"))
      and (subj|test("[;—-]\\s*rec:"));
    def pk: (subj|startswith("⏳")) or (subj|startswith("⛔")) or (parked and (($sw and sweepable)|not));
    ([.[]|select((.status=="pending" or .status=="in_progress") and (pk|not))]) as $o
    | ([$o[]|select((subj|startswith("❓"))|not)]) as $plain
    | ([.[]|select(.status=="pending" or .status=="in_progress")]|map(.id|tostring)) as $live
    | ([$o[]|select(waits as $w | ($w | map(. as $x | select($live|index($x))) | length) == 0)]) as $st
    | "\($o|length)\u001f\($plain|length)\u001f\([.[]|select(.status=="completed")]|length)\u001f\(($st[0].subject // "")|gsub("\u001f";" "))\u001f\($st[0].id // "")\u001f\(($st[0].done_when // "")|gsub("\u001f";" "))\u001f\($st|length)"
  ' "${files[@]}" 2>/dev/null
}

cmd="${1:-list}"; shift || true
case "$cmd" in
  add) mkdir -p "$DIR" || exit 1
    # --done "<acceptance>" (R30·d1) sets the done-when criterion for the task(s) added in this
    # call; remaining args are subjects. A task that carries its own acceptance re-derives the
    # right next action after a context compaction, not just "there's a thing called X".
    # --context "<files/flows>" (R99) names the 2-4 things actually load-bearing for the task, so
    # resuming after a compaction or a `/clear` means reading those, not re-exploring the repo to
    # rediscover what's in play — the same survives-context-loss property done_when has, for scope
    # instead of acceptance.
    dw=""; ctx=""; subs=()
    # Neither flag may swallow the OTHER as its value (was: `--context --done "x"` silently parsed
    # --context's value as the literal string "--done" and turned "x" into a second bogus task) —
    # refuse loudly instead of guessing which one the caller meant.
    while [ "$#" -gt 0 ]; do case "$1" in
      --done) shift; case "${1:-}" in --done|--context) echo "tq: --done needs a value" >&2; exit 1 ;; *) dw="${1:-}" ;; esac ;;
      --context) shift; case "${1:-}" in --done|--context) echo "tq: --context needs a value" >&2; exit 1 ;; *) ctx="${1:-}" ;; esac ;;
      *) subs+=("$1") ;;
    esac; shift || true; done
    [ "${#subs[@]}" -gt 0 ] || { usage; exit 1; }
    # Stamp this session's store with its repo root (once), so resume can scope to a repo
    # without reading any native session transcript. tq runs in the repo the model is working.
    [ -f "$DIR/.root" ] || { r="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"; printf '%s' "$r" > "$DIR/.root" 2>/dev/null || true; }
    [ -f "$DIR/.repo" ] || printf '%s' "$(repo_id)" > "$DIR/.repo" 2>/dev/null || true   # path-stable identity (survives moves)
    for s in "${subs[@]}"; do [ -n "$s" ] || continue
      id="$(claim_id)"          # claimed per subject, so a multi-add cannot stride over a racer
      # `blocks`/`blockedBy` are VESTIGIAL — written empty here, never set by any verb, never read
      # by anything (grepped 2026-08-12: zero readers, zero writers). Dependencies are parsed from
      # the SUBJECT as `after #<id>` by stopfields(). Kept only so old task files stay shape-stable;
      # do NOT reach for them. They cost two tool calls of misdiagnosis by looking like the
      # mechanism they are not — the R58a "data nobody reads" shape, in schema form.
      jq -n --arg id "$id" --arg s "$s" --arg dw "$dw" --arg ctx "$ctx" '{id:$id,subject:$s,status:"pending",done_when:$dw,context:$ctx,blocks:[],blockedBy:[]}' >"$DIR/.$id.tmp" && mv "$DIR/.$id.tmp" "$DIR/$id.json"
      echo "added #$id  $s${dw:+  (done when: $dw)}${ctx:+  (context: $ctx)}"; done
    delta ;;
  doing) { [ "$#" -ge 1 ] && [ -f "$DIR/${1:-}.json" ]; } || { echo "tq: no task #${1:-?}" >&2; exit 1; }; set_task "$1" in_progress "${2:-}"; echo "#$1 → in_progress"; delta ;;
  # `--seen` (R109) is the evidence that the work was observed WHERE THE OWNER MEETS IT. Optional
  # by design: making it mandatory would gate every routine close behind prose and train exactly
  # the rubber-stamping seen-gate.sh exists to refuse.
  done)
    id="${1:-}"; [ "$#" -ge 1 ] && shift; sv=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --seen) shift; case "${1:-}" in ""|-*) echo "tq: --seen needs a value" >&2; exit 1 ;; *) sv="$1" ;; esac ;;
        *) echo "tq: usage: tq done <id> [--seen \"<what was exercised, in which running thing>\"]" >&2; exit 1 ;;
      esac; shift
    done
    { [ -n "$id" ] && [ -f "$DIR/$id.json" ]; } || { echo "tq: no task #${id:-?}" >&2; exit 1; }
    if [ -n "$sv" ]; then
      # GUARD BEFORE THE STATE CHANGE. A rubber stamp must leave the task OPEN — a gate that
      # complains about a task it has already closed is decorative.
      g="$(dirname "$0")/seen-gate.sh"
      if [ -x "$g" ]; then "$g" check "$sv" || exit 2
      # Best-effort, never break the close (R68) — but SAY SO, or the gate could silently vanish
      # and the queue would keep reporting evidence nothing had checked (R48, gates stay wired).
      else echo "tq: warning — seen-gate.sh not found at $g; recording --seen unchecked" >&2; fi
      f="$DIR/$id.json"; t="$DIR/.$id.tmp"; jq --arg v "$sv" '.seen=$v' "$f" >"$t" && mv "$t" "$f"
    fi
    set_task "$id" completed ""; echo "#$id → completed${sv:+  (seen: $sv)}"; echo; report ;;
  cancel) { [ "$#" -eq 1 ] && [ -f "$DIR/${1:-}.json" ]; } || { echo "tq: no task #${1:-?}" >&2; exit 1; }; set_task "$1" cancelled ""; echo "#$1 → cancelled (retracted; kept for audit, excluded from counts)"; delta ;;
  note) { [ "$#" -eq 2 ] && [ -n "$2" ] && [ -f "$DIR/$1.json" ]; } || { echo "tq: usage: tq note <id> \"<breadcrumb>\"" >&2; exit 1; }; append_note "$1" "$2"; echo "#$1 note added" ;;
  done-when|dw) { [ "$#" -eq 2 ] && [ -f "$DIR/${1:-}.json" ]; } || { echo "tq: usage: tq done-when <id> \"<acceptance>\"" >&2; exit 1; }
    f="$DIR/$1.json"; t="$DIR/.$1.tmp"; jq --arg d "$2" '.done_when=$d' "$f" >"$t" && mv "$t" "$f"; echo "#$1 done-when set" ;;   # no delta: counts can't change (R69)
  context|ctx) { [ "$#" -eq 2 ] && [ -f "$DIR/${1:-}.json" ]; } || { echo "tq: usage: tq context <id> \"<files/flows>\"" >&2; exit 1; }
    f="$DIR/$1.json"; t="$DIR/.$1.tmp"; jq --arg c "$2" '.context=$c' "$f" >"$t" && mv "$t" "$f"; echo "#$1 context set" ;;   # no delta: counts can't change (R69)
  # ORPHANED-STATE REPORTING lives in bin/tq-orphans.sh. Extracted at the 300-line cap (behaviour unchanged, still R96),
  # the same move as ci-watch.sh / da-gate.sh / mutate-gate.sh: it is a DIAGNOSTIC over the state
  # dir, not queue mechanics, and it already had its own tests. `exec` so its exit code is tq's.
  orphans) exec "$(dirname "$0")/tq-orphans.sh" "$@" ;;

  prune)
    # R81 follow-up: PERF#1 made the cross-session resume scan 56x faster, but it is still O(store)
    # — just with a tiny constant. This is what keeps the store BOUNDED rather than merely cheap.
    #
    # Deliberately a CLI command and NOT wired into any hook: R68 forbids a hook deleting anything,
    # and that rule is right — an unattended delete of the owner's history is exactly the blast
    # radius it exists to prevent. Scoped to THIS repo's session dirs only: the store is shared
    # across projects, and pruning another project's history from here would be cross-repo bleed.
    days=90; dry=0
    while [ "$#" -gt 0 ]; do case "$1" in
      --days) days="$(printf '%s' "${2:-}" | tr -dc '0-9')"; [ -n "$days" ] || { echo "tq prune: --days needs a number" >&2; exit 1; }; shift 2 ;;
      --dry-run|-n) dry=1; shift ;;
      *) echo "tq prune: unknown argument '$1'" >&2; exit 1 ;;
    esac; done
    root="$(repo_root)"; rid="$(repo_id)"; gone=0; kept=0
    for d in "$STORE"/*/; do
      [ -d "$d" ] || continue
      [ "${d%/}" = "${DIR%/}" ] && { kept=$((kept+1)); continue; }          # never THIS session
      # NEVER follow a symlink. The glob matches symlinks-to-directories and yields a TRAILING
      # SLASH, which makes `rm -rf` recurse THROUGH the link and empty the target — measured:
      # an archived session dir outside the store was destroyed while the link itself survived,
      # and prune reported success. A linked store dir is someone's deliberate arrangement; skip it.
      [ -L "${d%/}" ] && { kept=$((kept+1)); continue; }
      # this repo only (same identity-then-legacy-abspath rule as matching_files)
      { [ "$(cat "$d.repo" 2>/dev/null || true)" = "$rid" ] || [ "$(cat "$d.root" 2>/dev/null || true)" = "$root" ]; } || continue
      # ANY open work — pending or in_progress, including ❓ parked and ⏳ blocked — is a hard keep.
      # The EXIT STATUS is the guard, not the stdout: `jq -s` prints `0` and exits 2 when it cannot
      # OPEN a file (permissions, I/O error, a root-owned file from a sudo run, a flaky SD card),
      # so reading stdout alone turned "unreadable" into "zero open tasks" and DELETED the store.
      # Measured: a chmod-000 file holding a ❓ parked task was destroyed, reported as success.
      # Any failure to read is now a KEEP — deleting what we could not inspect is unforgivable here.
      if ! n="$(jq -s '[.[]|select(.status=="pending" or .status=="in_progress")]|length' "$d"*.json 2>/dev/null)"; then
        kept=$((kept+1)); continue
      fi
      case "$n" in ''|*[!0-9]*) kept=$((kept+1)); continue ;; esac
      [ "$n" -gt 0 ] && { kept=$((kept+1)); continue; }
      # Age: POSIX `-mtime` (BSD find has no -newermt). Any file touched inside the window keeps it.
      [ -n "$(find "$d" -type f -mtime -"$days" 2>/dev/null | head -1)" ] && { kept=$((kept+1)); continue; }
      if [ "$dry" -eq 1 ]; then echo "  would remove $(basename "${d%/}")"
      else rm -rf "${d%/}" 2>/dev/null || { kept=$((kept+1)); continue; }; fi
      gone=$((gone+1))
    done
    if [ "$dry" -eq 1 ]; then echo "tq prune (dry run): $gone finished store(s) older than ${days}d would go, $kept kept"
    else echo "tq prune: removed $gone finished store(s) older than ${days}d, kept $kept (any open/parked/blocked work is never touched)"; fi ;;
  report) report ;;
  # Internal, for stop-autopilot.sh (R86·b). Undocumented in usage() on purpose: it is a hook
  # interface, not something the model should drive. Exit 1 with no output when the store is
  # empty, so the caller can tell "no tasks" from "unreadable" and stay best-effort either way.
  stopfields) stopfields "${1:-false}" ;;
  # `list` is the NON-TRUNCATING reader — parked payloads and `seen:` evidence are both read back
  # here. A `--seen` value nobody prints is pure cost: that is exactly R58·a's retired capture hook
  # (456KB banked, zero readers). So it renders, or the field should not exist.
  list) l=""; if [ -d "$DIR" ]; then for f in "$DIR"/*.json; do [ -f "$f" ] || continue; l+="$(jq -r '"\(.id)\t\(.status)\t\(.subject)\t\(.seen // "")"' "$f" 2>/dev/null)"$'\n'; done; fi
    if printf '%s' "$l" | grep -q '[^[:space:]]'; then printf '%s' "$l" | sort -n | awk -F'\t' 'NF>=3{printf "  #%s  [%s]  %s\n",$1,$2,$3; if(NF>=4&&$4!="")printf "        seen: %s\n",$4}'; else echo "(queue empty)"; fi ;;
  -h|--help|help) usage ;;
  *) echo "tq: unknown command '$cmd'" >&2; usage; exit 1 ;;
esac
